# Copy to .env and fill in. Never commit .env.
#
# Supabase project URL — e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Public anon key (safe to ship to the browser; respects RLS)
SUPABASE_ANON_KEY=

# Service role key (BYPASSES RLS — server / scripts only, never the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Seed credentials (used by scripts/seed.ts to create the first three logins)
SEED_OWNER_EMAIL=owner@sunline.test
SEED_OWNER_PASSWORD=
SEED_CLIENT_EMAIL=client@brightroof.test
SEED_CLIENT_PASSWORD=
SEED_SETTER_EMAIL=setter@sunline.test
SEED_SETTER_PASSWORD=
SEED_CONFIRMER_EMAIL=confirmer@sunline.test
SEED_CONFIRMER_PASSWORD=

# Demo client credentials (used by scripts/seed-demo.ts)
DEMO_CLIENT_EMAIL=demo@sunline.test
DEMO_CLIENT_PASSWORD=
